<?xml version="1.0"?>
<sdf version="1.9">
  <world name="boxed_nav_test">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <grid>true</grid>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot from launch spawns near (0, 3.5). Obstacles form a boxed arena with openings. -->

    <!-- Outer boundary -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 9.5 0.75 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>18 0.3 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>18 0.3 1.5</size></box></geometry></visual></link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.5 0.75 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>18 0.3 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>18 0.3 1.5</size></box></geometry></visual></link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>8.8 3.5 0.75 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.3 12.3 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 12.3 1.5</size></box></geometry></visual></link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-8.8 3.5 0.75 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.3 12.3 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 12.3 1.5</size></box></geometry></visual></link>
    </model>

    <!-- Inner boxes near start for mapping/navigation stress -->
    <model name="inner_box_1">
      <static>true</static>
      <pose>0.0 5.8 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>2.0 0.5 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 0.5 1.0</size></box></geometry></visual></link>
    </model>
    <model name="inner_box_2">
      <static>true</static>
      <pose>-2.6 4.6 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.6 2.8 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 2.8 1.0</size></box></geometry></visual></link>
    </model>
    <model name="inner_box_3">
      <static>true</static>
      <pose>2.6 2.6 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.6 2.8 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 2.8 1.0</size></box></geometry></visual></link>
    </model>
    <model name="inner_box_4">
      <static>true</static>
      <pose>-0.2 1.0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3.4 0.6 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>3.4 0.6 1.0</size></box></geometry></visual></link>
    </model>

    <!-- Spawn protection: keep immediate spawn area clear around (0,3.5) -->
    <model name="spawn_marker">
      <static>true</static>
      <pose>0 3.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><cylinder><radius>0.45</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
