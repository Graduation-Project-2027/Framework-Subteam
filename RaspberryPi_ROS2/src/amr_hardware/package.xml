<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_hardware</name>
  <version>0.1.0</version>
  <description>Real-robot drivers for the AMR on the Raspberry Pi 5: CAN bridge (hoverboard drive + e-stop controller), MPU9250 IMU, dual RPLidar A1M8.</description>
  <maintainer email="team@amr.local">AMR Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
