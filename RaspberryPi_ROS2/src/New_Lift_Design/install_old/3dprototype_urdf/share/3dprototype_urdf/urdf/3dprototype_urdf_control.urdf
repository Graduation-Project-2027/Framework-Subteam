<?xml version="1.0" encoding="utf-8"?>
<robot name="3dprototype_urdf_control">
  <link name="drive_base" />
  <link name="drive_handle" />

  <joint name="lead_screw_turns" type="prismatic">
    <parent link="drive_base" />
    <child link="drive_handle" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-10.0" upper="10.0" effort="1.0" velocity="5.0" />
  </joint>
</robot>
