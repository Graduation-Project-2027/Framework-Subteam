        <material name="lift_silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
    </link>
    <link name="${prefix}center_front_left_y_link">
    </link>
    <link name="${prefix}center_front_left_link">
    </link>
    <link name="${prefix}center_front_left_bar2_link">
    </link>
    <link name="${prefix}center_back_left_y_link">
    </link>
    <link name="${prefix}center_back_left_link">
    </link>
    <link name="${prefix}center_back_left_bar2_link">
