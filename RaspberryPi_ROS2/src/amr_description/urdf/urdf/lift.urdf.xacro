        <origin xyz="0.0339784017036739 -0.0310075509781577 0.00249999999999832" rpy="0 0 0"/>
        <mass value="0.0105010102633798"/>
        <inertia ixx="5.07750472693072E-06" ixy="5.01950408025561E-06" ixz="1.81142454407637E-21" iyy="5.73960989932836E-06" iyz="-2.15372225713115E-21" izz="1.07733604168283E-05"/>
