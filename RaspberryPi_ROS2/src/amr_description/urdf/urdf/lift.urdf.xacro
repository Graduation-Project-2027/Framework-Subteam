<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================================
       NEW lift mechanism (SolidWorks scissor / lead-screw lift export, meshes in
       meshes/lift_v2).  The full CAD assembly is grafted onto the robot.
         * base_link  -> lift_base_link, FIXED-mounted on the robot at z=0.165
         * lead screws, nuts and the 8 scissor bars are reproduced from the CAD
           and FROZEN (fixed joints) as faithful decoration
         * table_link -> lift_link, the ONE actuated DOF, driven up/down by the
           existing JointPositionController on /lift_joint/cmd_pos
       Only the table carries collision (a clean box) so the lifting contact
       with the rack is stable.  Physical stroke = 5 cm (the real bench rig).

       Geometry in WORLD frame (robot base_link sits ~0.036 m above ground,
       table top world Z = base_link_z + mount_z + 0.1553).
         stowed table top                         is 0.320 m
         shelf_1 underside                        is 0.350 m  (rack/model.sdf)
         -> drive-under clearance                 is 0.030 m
         raised table top = 0.320 + 0.05          is 0.370 m
         -> rack lifted off floor                 is 0.020 m
       Only the table has collision, so the frozen scissor bars (visually ~0.33)
       never block driving under.
       ===================================================================== -->

  <xacro:property name="lift_range"   value="0.05" />    <!-- 5 cm stroke -->
  <xacro:property name="lift_mount_z" value="0.165" />   <!-- base mount height -->

  <xacro:macro name="lift_mechanism" params="prefix parent_link">

    <!-- Fixed mount: lift base onto the robot chassis.  Yaw = 90 deg so the
         lift's long axis runs along the robot (front-back) instead of across
         it.  Flip to -1.5708 if it ends up facing the wrong way. -->
    <joint name="${prefix}lift_mount_joint" type="fixed">
      <origin xyz="0 0 ${lift_mount_z}" rpy="0 0 1.5708"/>
      <parent link="${prefix}${parent_link}"/>
      <child link="${prefix}lift_base_link"/>
    </joint>

    <link name="${prefix}lift_base_link">
      <inertial>
        <origin xyz="-3.40389888021849E-16 0.0162456940272311 -2.39641703952862E-16" rpy="0 0 0"/>
        <mass value="1.68121625180425"/>
        <inertia ixx="0.0272950436547983" ixy="-2.92223113526388E-20" ixz="-1.84544191038011E-11" iyy="0.0343155917992195" iyz="-1.05679271570795E-18" izz="0.00716778008863357"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="file://$(find amr_description)/meshes/lift_v2/base_link.STL"/></geometry>
        <material name="lift_silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
    </link>
    <link name="${prefix}lead_screw_left">
      <inertial>
        <origin xyz="-1.34057314777475E-05 -6.77644773028273E-06 0.0294401866597978" rpy="0 0 0"/>
        <mass value="0.0379707312460712"/>
        <inertia ixx="3.37228023983108E-05" ixy="-1.3889874635159E-09" ixz="1.15131781987586E-09" iyy="3.37251058671091E-05" iyz="-1.45877067588279E-10" izz="4.86890781190937E-07"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="file://$(find amr_description)/meshes/lift_v2/lead_screw_left.STL"/></geometry>
        <material name="lift_silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
    </link>
    <link name="${prefix}nut_left">
      <inertial>
        <origin xyz="0.00687314050972793 1.96121777595063E-08 -0.0181466873810528" rpy="0 0 0"/>
        <mass value="0.140907892389316"/>
        <inertia ixx="0.00011787445699265" ixy="9.41333437036286E-12" ixz="3.90054331323103E-06" iyy="2.82481439477633E-05" iyz="-2.31817021112486E-11" izz="0.000112986783640138"/>
      </inertial>
      <visual>
