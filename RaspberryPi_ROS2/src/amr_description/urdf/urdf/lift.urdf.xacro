      <parent link="${prefix}bar2_back_right_pivot"/>
      <child link="${prefix}bar2_back_right"/>
    </joint>

    <!-- The ONE actuated joint: raises the table (lift_link).  Origin/axis
         copied from the CAD's joint_table_link so the platform sits correctly;
         positive command = up. -->
    <joint name="${prefix}lift_joint" type="prismatic">
      <origin xyz="0 0 0.11956" rpy="3.1416 0 3.1416"/>
      <parent link="${prefix}lift_base_link"/>
      <child link="${prefix}lift_link"/>
      <axis xyz="0 0 -1"/>
      <limit lower="0" upper="${lift_range}" effort="200" velocity="0.20"/>
      <dynamics damping="15.0" friction="2.0"/>
    </joint>

    <transmission name="${prefix}lift_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}lift_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}lift_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <!-- High friction on the table so the carried rack doesn't slip -->
    <gazebo reference="${prefix}lift_link">
      <material>Gazebo/Grey</material>
      <collision>
        <surface>
          <friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction>
        </surface>
      </collision>
    </gazebo>
    <gazebo reference="${prefix}lift_base_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>

  </xacro:macro>
</robot>
