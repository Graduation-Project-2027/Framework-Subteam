    <link name="${prefix}lift_link">
      <inertial>
        <origin xyz="-9.37010239009259E-17 6.17838764671444E-16 0.00578440190069766" rpy="0 0 0"/>
        <mass value="0.395241194912214"/>
        <inertia ixx="0.00859776795504631" ixy="2.81406844390508E-18" ixz="1.83372734384748E-18" iyy="0.00182878805013723" iyz="9.07083694915163E-18" izz="0.0103772362248568"/>
