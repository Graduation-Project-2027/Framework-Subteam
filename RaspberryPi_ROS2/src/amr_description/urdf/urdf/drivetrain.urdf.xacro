<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Placeholder drivetrain until the updated CAD is exported: two hoverboard hub motors
       on one axle through the robot centre (differential drive) and four passive casters
       in the corners. MEASURE all values; wheel_radius / wheel_separation must match
       amr_hardware/config/hardware.yaml. base_height comes from base.urdf.xacro. -->
  <xacro:property name="drive_wheel_radius" value="0.0825" />
  <xacro:property name="drive_wheel_width" value="0.055" />
  <xacro:property name="drive_wheel_separation" value="0.55" />
  <xacro:property name="drive_wheel_mass" value="3.5" />
  <xacro:property name="caster_radius" value="0.03" />
  <xacro:property name="caster_mass" value="0.2" />
  <xacro:property name="caster_x" value="0.27" />
  <xacro:property name="caster_y" value="0.22" />

  <xacro:macro name="drive_wheel" params="prefix side y">
    <link name="${prefix}${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${drive_wheel_mass}"/>
        <inertia
          ixx="${drive_wheel_mass / 12.0 * (3 * drive_wheel_radius ** 2 + drive_wheel_width ** 2)}" ixy="0" ixz="0"
          iyy="${drive_wheel_mass / 2.0 * drive_wheel_radius ** 2}" iyz="0"
          izz="${drive_wheel_mass / 12.0 * (3 * drive_wheel_radius ** 2 + drive_wheel_width ** 2)}"/>
      </inertial>
    </link>

    <!-- Axis +y for both wheels: positive joint velocity rolls the robot forward,
         the same convention as the hoverboard firmware. -->
    <joint name="${prefix}${side}_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${side}_wheel_link"/>
      <origin xyz="0 ${y} ${drive_wheel_radius - base_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="caster" params="prefix name x y">
    <link name="${prefix}${name}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia
          ixx="${0.4 * caster_mass * caster_radius ** 2}" ixy="0" ixz="0"
          iyy="${0.4 * caster_mass * caster_radius ** 2}" iyz="0"
          izz="${0.4 * caster_mass * caster_radius ** 2}"/>
      </inertial>
    </link>

    <joint name="${prefix}${name}_caster_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${name}_caster_link"/>
      <origin xyz="${x} ${y} ${caster_radius - base_height}" rpy="0 0 0"/>
    </joint>

    <!-- Frictionless sphere: a swivel caster offers no lateral resistance. -->
    <gazebo reference="${prefix}${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="drivetrain" params="prefix">
    <xacro:drive_wheel prefix="${prefix}" side="left" y="${drive_wheel_separation / 2}"/>
    <xacro:drive_wheel prefix="${prefix}" side="right" y="${-drive_wheel_separation / 2}"/>
    <xacro:caster prefix="${prefix}" name="front_left" x="${caster_x}" y="${caster_y}"/>
    <xacro:caster prefix="${prefix}" name="front_right" x="${caster_x}" y="${-caster_y}"/>
    <xacro:caster prefix="${prefix}" name="back_left" x="${-caster_x}" y="${caster_y}"/>
    <xacro:caster prefix="${prefix}" name="back_right" x="${-caster_x}" y="${-caster_y}"/>
  </xacro:macro>
</robot>
