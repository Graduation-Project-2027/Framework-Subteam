<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_description</name>
  <version>0.0.0</version>
  <description>AMR URDF/Xacro (dual lidar, IMU, differential drive with corner casters, lift), meshes, Gazebo models and worlds</description>
  <maintainer email="youssefsaeed11004@gmail.com">youssef-adel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Desktop only, for display_urdf.launch.py (skipped by install_dependencies.sh on the robot) -->
  <exec_depend>urdf_launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
