<?xml version="1.0"?>
<robot name="mecanum_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <xacro:arg name="robot_name" default="mecanum_robot"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="use_gazebo" default="false"/>

    <xacro:include filename="$(find mecanum_robot_description)/urdf/urdf/base.urdf.xacro"/>
    <xacro:include filename="$(find mecanum_robot_description)/urdf/urdf/mecanum_wheel.urdf.xacro"/>
    <xacro:include filename="$(find mecanum_robot_description)/urdf/urdf/lidar.urdf.xacro"/>
    <xacro:include filename="$(find mecanum_robot_description)/urdf/urdf/imu.urdf.xacro"/>
    <xacro:include filename="$(find mecanum_robot_description)/urdf/urdf/materials.xacro"/> 
    <xacro:include filename="$(find mecanum_robot_description)/urdf/urdf/lift.urdf.xacro"/>
    <xacro:if value="$(arg use_gazebo)">
      <xacro:include filename="$(find mecanum_robot_description)/urdf/plugins/mecanum_robot.gazebo"/>
    </xacro:if>

    <!-- base -->
    <xacro:base prefix="$(arg prefix)"/>

    <!-- lift -->
    <xacro:lift_mechanism prefix="$(arg prefix)" parent_link="base_link" />

    <!-- front_left -->
    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="front_left"
      x_reflect="1"
      y_reflect="1"
      x_rotation="${pi/2}"
      y_rotation= "${pi/2}"
      z_rotation= "0"
      z="-1"/>

    <!-- front_right -->
    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="front_right"
      x_reflect="1"
      y_reflect="-1"
      x_rotation="${-pi/2}"
      y_rotation= "${(pi/2)}"
      z_rotation= "0"
      z="1"/>

    <!-- back_left -->
    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="back_left"
      x_reflect="-1"
      y_reflect="1"
      x_rotation="${pi/2}"
      y_rotation= "${pi/2}"
      z_rotation= "0"
      z="-1"/>

    <!-- back_right -->
    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="back_right"
      x_reflect="-1"
      y_reflect="-1"
      x_rotation="${-pi/2}"
      y_rotation= "${pi/2}"
      z_rotation= "0"
      z="1"/>

    <!-- lidar -->
    <xacro:lidar_sensor
      prefix="$(arg prefix)"
      parent="base_link"
      frame_id="laser_frame"
      xyz_offset="0.29 0 0.15"
      rpy_offset="0 0 0"
      mesh_xyz_offset="0 0 0"
      mesh_rpy_offset="0 0 0"
      topic_name="scan"/>

    <!-- imu -->
    <xacro:imu_sensor
      prefix="$(arg prefix)"
      parent="base_link"
      frame_id="imu"
      xyz_offset="0 0 0.016"
      rpy_offset="0 0 0"
      update_rate="15.0"
      topic_name="imu/data"/>






    <!-- Add Gazebo frictions -->
    <xacro:if value="$(arg use_gazebo)">
    <gazebo reference='$(arg prefix)front_left_wheel_link'>
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>8</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="$(arg prefix)base_footprint">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference='$(arg prefix)back_left_wheel_link'>
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>8</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="$(arg prefix)base_footprint">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference='$(arg prefix)front_right_wheel_link'>
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>8</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="$(arg prefix)base_footprint">1 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference='$(arg prefix)back_right_wheel_link'>
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>8</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="$(arg prefix)base_footprint">1 -1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

    <gazebo reference="$(arg prefix)base_link">
      <mu1>0.000002</mu1>
      <mu2>0.000002</mu2>
    </gazebo>
    </xacro:if>

</robot>
