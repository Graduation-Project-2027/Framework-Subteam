    <!-- Aisle 2 static obstacle                                        -->
    <!--   x=2.90 (centre of row), y=-1.80 (north/right dashed lane)  -->
    <!-- ============================================================= -->
    <model name="obstacle_aisle2">
      <static>true</static>
      <pose>2.90 -1.80 0.20 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- Loading zone decal — 4×4 m slab with LOADING AREA texture.   -->
    <!-- ============================================================= -->
    <include>
      <uri>model://loading_zone</uri>
      <name>loading_zone</name>
      <pose>14.0 0.0 0.0 0 0 0</pose>
    </include>

