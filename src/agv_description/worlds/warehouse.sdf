    <!-- ============================================================= -->
    <!-- Static obstacles configuration                                 -->
    <!--   Aisle 1: two obstacles alternating lanes                    -->
    <!--   Aisle 2: one obstacle                                       -->
    <!--   Aisle 4: clear (no obstacle model placed)                   -->
    <!-- ============================================================= -->
    <model name="obstacle_a1_left">
      <static>true</static>
      <pose>1.70 -5.60 0.20 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_a1_right">
      <static>true</static>
      <pose>4.10 -4.60 0.20 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_a2_single">
      <static>true</static>
      <pose>2.90 -1.20 0.20 0 0 0</pose>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.40 0.40</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================= -->
    <!-- Aisle 3 dynamic actor                                          -->
    <!--   Walks x=0.0 → 5.80 m along aisle 3 yellow center (y=1.70) -->
    <!--   ~0.75 m/s → 7.7 s one-way.                                 -->
    <!-- ============================================================= -->
    <actor name="walker_aisle3">
      <pose>0 1.70 0 0 0 0</pose>
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0.0</time> <pose>0.00 1.70 0 0 0 0</pose></waypoint>
          <waypoint><time>7.7</time> <pose>5.80 1.70 0 0 0 0</pose></waypoint>
          <waypoint><time>8.2</time> <pose>5.80 1.70 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>15.9</time><pose>0.00 1.70 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>16.4</time><pose>0.00 1.70 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ============================================================= -->
    <!-- Loading zone decal — 4×4 m slab with LOADING AREA texture.   -->
    <!-- ============================================================= -->
    <include>
      <uri>model://loading_zone</uri>
      <name>loading_zone</name>
      <pose>14.0 0.0 0.0 0 0 0</pose>
    </include>

  </world>
