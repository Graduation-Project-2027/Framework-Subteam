<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lift_mass" value="5.0" />
  <!-- Realistic latent-lift travel: the lift contacts the rack's bottom
       shelf after ~0.07 m, so 0.20 m of travel raises the rack ~0.13 m —
       enough to clear the floor (no leg scrape on extraction) but the legs
       stay in the scanner plane, exactly as on the real robot.  The carried
       legs are handled by the payload_filter, NOT by lifting them out of the
       beam (which is impossible on hardware). -->
  <xacro:property name="lift_range" value="0.20" />

  <xacro:macro name="lift_mechanism" params="prefix parent_link">

    <link name="${prefix}lift_link">
      <visual>
        <origin xyz="0 -0.25 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find agv_description)/meshes/robot_3d/visual/lifting_mechanism.stl"/>
        </geometry>
        <material name="silver">
          <color rgba="0.75 0.75 0.75 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 -0.25 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find agv_description)/meshes/robot_3d/visual/lifting_mechanism.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${lift_mass}"/>
        <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
      </inertial>
    </link>

    <joint name="${prefix}lift_joint" type="prismatic">
      <parent link="${prefix}${parent_link}"/>
      <child link="${prefix}lift_link"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="${lift_range}" effort="200" velocity="0.20"/>
      <safety_controller
        soft_lower_limit="0.0"
        soft_upper_limit="${lift_range}"
        k_position="50.0"
        k_velocity="20.0"/>
      <dynamics damping="15.0" friction="2.0"/>
    </joint>

    <transmission name="${prefix}lift_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}lift_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}lift_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>

    <gazebo reference="${prefix}lift_link">
      <material>Gazebo/Grey</material>
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>

  </xacro:macro>
</robot>
